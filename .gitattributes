# Auto detect text files and perform LF normalization
* text=auto

# Ensure Unix scripts and Gradle wrapper keep Unix LF line endings
gradlew text eol=lf
android/gradlew text eol=lf
*.sh text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Source files
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
